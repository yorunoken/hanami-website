# Hanami web configuration
# Rename this file to `.env`

# ── App

# Bun/Elysia server port.
PORT=3000

# Public URL of this deployment. Use http://localhost:3000 locally.
BETTER_AUTH_URL=https://hanami.yorunoken.com

# Signs and encrypts Better Auth data. Generate once per environment:
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# ── Databases

# MariaDB URL for Better Auth, OAuth state, and Companion-owned data.
# Format: mysql://USER:PASSWORD@HOST:3306/DATABASE
WEB_DATABASE_URL=mysql://user:password@host:3306/hanami

# Existing Hanami Bot database, used for Discord-linked bot and osu! data.
BOT_DATABASE_URL=mysql://user:password@host:3306/hanami_bot

# Optional disposable MySQL database for integration tests. Never use real data.
TEST_DATABASE_URL=

# Run `bun run db:migrate` after configuring WEB_DATABASE_URL.

# ── Discord login 

# Create an app at https://discord.com/developers/applications and copy its
# Application ID and OAuth2 client secret.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Redirects: http://localhost:3000/api/auth/callback/discord (local)
# or https://hanami.yorunoken.com/api/auth/callback/discord (production).

# ── osu! linking

# Register an OAuth app at https://osu.ppy.sh/home/account/edit, then copy its
# client ID and secret. The registered callback must match OSU_CALLBACK_URL.
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=
OSU_CALLBACK_URL=https://hanami.yorunoken.com/api/callback

# ── Bot account links

# Shared secret used when the bot requests a website link ticket. Put the same
# value in both deployments, but do not reuse BETTER_AUTH_SECRET.
# Generate with: openssl rand -hex 32
BOT_LINK_SECRET=
