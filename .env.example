# Hanami web configuration
# Rename this file to `.env`

# ── App

# Bun/Elysia server port.
PORT=3000

# Public URL of this deployment. Use http://localhost:3000 locally.
BETTER_AUTH_URL=https://hanami.yorunoken.com

# Signs and encrypts Better Auth data. Generate once per environment:
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# ── Databases

# MySQL URL for Better Auth, canonical identities, migrations, and Companion data.
# Format: mysql://USER:PASSWORD@HOST:3306/DATABASE
WEB_DATABASE_URL=mysql://user:password@host:3306/hanami_web

# Existing Hanami Bot database, used only by the temporary compatibility bridge
# and existing-user identity backfill.
BOT_DATABASE_URL=mysql://user:password@host:3306/hanamibot

# Disposable integration-test databases. Never point either value at real data,
# WEB_DATABASE_URL, or BOT_DATABASE_URL.
TEST_DATABASE_URL=
TEST_BOT_DATABASE_URL=

# Run `bun run db:migrate` after configuring WEB_DATABASE_URL.

# ── Discord login 

# Create an app at https://discord.com/developers/applications and copy its
# Application ID and OAuth2 client secret.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Redirects: http://localhost:3000/api/auth/callback/discord (local)
# or https://hanami.yorunoken.com/api/auth/callback/discord (production).

# ── osu! authentication

# Register a dedicated OAuth app at https://osu.ppy.sh/home/account/edit. These
# credentials are for Hanami Web authentication; do not silently reuse an older
# app whose registered callback points at the removed custom linking route.
OSU_AUTH_CLIENT_ID=
OSU_AUTH_CLIENT_SECRET=

# Redirects: http://localhost:3000/api/auth/oauth2/callback/osu (local)
# or https://hanami.yorunoken.com/api/auth/oauth2/callback/osu (production).
# osu! requires an exact callback match. The requested scope is `identify`.

# ── Bot account links

# Shared secret used when the bot requests a website link ticket. Put the same
# value in both deployments, but do not reuse BETTER_AUTH_SECRET.
# Generate with: openssl rand -hex 32
BOT_LINK_SECRET=
