generator client {
  provider = "prisma-client"
  output   = "../../node_modules/.prisma/hanami-bot"
}

datasource db {
  provider = "mysql"
}

model User {
  id           String  @id @db.VarChar(255)
  banchoId     String? @db.VarChar(255)
  score_embeds Int?
  mode         String? @db.VarChar(255)
  embed_type   String? @db.VarChar(255)
  score_data   Int?

  @@map("users")
}
